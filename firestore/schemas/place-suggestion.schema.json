{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "place-suggestion.schema.json",
  "title": "PlaceSuggestion",
  "description": "Catálogo de lugares sugeridos en el selector de ubicación.",
  "x-firestore-collection": "placeSuggestions",
  "x-document-id": "id asignado al sembrar el catálogo",
  "x-dto": "edu.uniquindio.co.tribooo.data.remote.placesuggestion.PlaceSuggestionDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "neighborhood": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "x-firestore-type": "geopoint",
      "description": "GeoPoint de Firestore (coordenadas WGS84).",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "neighborhood",
    "detail",
    "location"
  ],
  "additionalProperties": false
}
