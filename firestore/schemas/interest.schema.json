{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interest.schema.json",
  "title": "Interest",
  "description": "Marca \"me interesa\" de un usuario sobre un evento.",
  "x-firestore-collection": "interests",
  "x-document-id": "\"{userId}_{eventId}\"",
  "x-dto": "edu.uniquindio.co.tribooo.data.remote.interest.InterestDto",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "users",
      "description": "Usuario."
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "events",
      "description": "Evento."
    }
  },
  "required": [
    "userId",
    "eventId"
  ],
  "additionalProperties": false
}
