{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "follow.schema.json",
  "title": "Follow",
  "description": "Un usuario sigue a otro.",
  "x-firestore-collection": "follows",
  "x-document-id": "\"{followerId}_{followedId}\"",
  "x-dto": "edu.uniquindio.co.tribooo.data.remote.follow.FollowDto",
  "type": "object",
  "properties": {
    "followerId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "users",
      "description": "Usuario que sigue."
    },
    "followedId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "users",
      "description": "Usuario seguido."
    }
  },
  "required": [
    "followerId",
    "followedId"
  ],
  "additionalProperties": false
}
