{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "Evento publicado por un vecino; pasa por moderación antes de mostrarse.",
  "x-firestore-collection": "events",
  "x-document-id": "UUID generado por la app",
  "x-dto": "edu.uniquindio.co.tribooo.data.remote.event.EventDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date-time",
      "x-firestore-type": "timestamp",
      "description": "Inicio del evento."
    },
    "endDate": {
      "type": "string",
      "format": "date-time",
      "x-firestore-type": "timestamp",
      "description": "Fin del evento (>= startDate)."
    },
    "multidia": {
      "type": "boolean",
      "description": "true si dura varios días.",
      "default": false
    },
    "place": {
      "type": "string",
      "description": "Nombre del lugar."
    },
    "neighborhood": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "x-firestore-type": "geopoint",
      "description": "GeoPoint de Firestore (coordenadas WGS84).",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "cupo": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Cupos disponibles; null = sin límite.",
      "minimum": 1
    },
    "contribution": {
      "type": [
        "object",
        "null"
      ],
      "description": "Aporte voluntario (mapa anidado); null si el evento es gratuito.",
      "properties": {
        "amount": {
          "type": "number",
          "description": "Monto sugerido en COP.",
          "minimum": 0
        },
        "cause": {
          "type": [
            "string",
            "null"
          ],
          "description": "Causa a la que se destina el aporte."
        }
      },
      "required": [
        "amount"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDIENTE",
        "ACTIVO",
        "RECHAZADO",
        "FINALIZADO"
      ],
      "default": "PENDIENTE"
    },
    "verified": {
      "type": "boolean",
      "description": "Verificado por un administrador.",
      "default": false
    },
    "publicationDate": {
      "type": "string",
      "format": "date-time",
      "x-firestore-type": "timestamp",
      "description": "Fecha de publicación."
    },
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "users",
      "description": "Usuario que organiza."
    },
    "categoryId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "categories",
      "description": "Categoría del evento."
    },
    "imageUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "URL de la portada; el resto de imágenes vive en \"eventImages\"."
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "startDate",
    "endDate",
    "multidia",
    "place",
    "neighborhood",
    "location",
    "status",
    "verified",
    "publicationDate",
    "organizerId",
    "categoryId"
  ],
  "additionalProperties": false
}
