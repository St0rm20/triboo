{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saved.schema.json",
  "title": "Saved",
  "description": "Evento guardado por un usuario.",
  "x-firestore-collection": "saved",
  "x-document-id": "\"{userId}_{eventId}\"",
  "x-dto": "edu.uniquindio.co.tribooo.data.remote.saved.SavedDto",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "users",
      "description": "Usuario."
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "x-firestore-ref": "events",
      "description": "Evento."
    }
  },
  "required": [
    "userId",
    "eventId"
  ],
  "additionalProperties": false
}
